{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["frontend", "backend", "config", "existingSecret", "migration", "ingress"],
  "properties": {
    "grafana_ip": { "type": "string" },
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "automount", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "frontend": { "$ref": "#/definitions/workload" },
    "backend": { "$ref": "#/definitions/workload" },
    "config": {
      "type": "object",
      "required": [
        "appOrigin",
        "apiOrigin",
        "s3Endpoint",
        "s3Region",
        "s3Bucket",
        "s3ForcePathStyle",
        "signedUrlTtlSeconds",
        "maxActiveUploadsPerUser"
      ],
      "properties": {
        "appOrigin": { "type": "string", "format": "uri" },
        "apiOrigin": { "type": "string", "format": "uri" },
        "sessionCookieName": { "type": "string", "minLength": 1 },
        "sessionTtlDays": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "s3Endpoint": { "type": "string", "format": "uri" },
        "s3Region": { "type": "string", "minLength": 1 },
        "s3Bucket": { "type": "string", "minLength": 1 },
        "s3ForcePathStyle": { "type": "string", "enum": ["true", "false"] },
        "signedUrlTtlSeconds": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "maxActiveUploadsPerUser": {
          "type": "string",
          "pattern": "^(?:[1-9]|1[0-9]|20)$"
        }
      }
    },
    "existingSecret": {
      "type": "object",
      "required": ["name", "keys"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "keys": {
          "type": "object",
          "required": ["databaseUrl", "s3AccessKeyId", "s3SecretAccessKey"],
          "properties": {
            "databaseUrl": { "type": "string", "minLength": 1 },
            "s3AccessKeyId": { "type": "string", "minLength": 1 },
            "s3SecretAccessKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "ttlSecondsAfterFinished", "command", "args"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "annotations": { "type": "object" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "host", "frontend", "backend", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string", "minLength": 1 },
        "frontend": { "$ref": "#/definitions/ingressRoute" },
        "backend": { "$ref": "#/definitions/ingressRoute" },
        "tls": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "required": ["replicaCount", "image", "containerPort", "service"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "resources": { "type": "object" },
        "startupProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object" },
        "podSecurityContext": { "type": "object" },
        "securityContext": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "ingressRoute": {
      "type": "object",
      "required": ["path", "pathType"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
      }
    }
  }
}
